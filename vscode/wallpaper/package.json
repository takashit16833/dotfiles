{
  "name": "vscode-wallpaper",
  "displayName": "VS Code Wallpaper",
  "description": "Generate a responsive, multiply-blended VS Code wallpaper stylesheet without patching VS Code.",
  "version": "0.7.3",
  "publisher": "takashit16833",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "vscodeWallpaper.preview",
        "title": "VS Code Wallpaper: Preview"
      },
      {
        "command": "vscodeWallpaper.showCss",
        "title": "VS Code Wallpaper: Show Generated CSS"
      },
      {
        "command": "vscodeWallpaper.showWorkbenchScript",
        "title": "VS Code Wallpaper: Show Temporary Workbench Script"
      },
      {
        "command": "vscodeWallpaper.showRemoveScript",
        "title": "VS Code Wallpaper: Show Remove Script"
      },
      {
        "command": "vscodeWallpaper.showDiagnosticsScript",
        "title": "VS Code Wallpaper: Show Read-only Workbench Diagnostics"
      },
      {
        "command": "vscodeWallpaper.showResponsiveTestScript",
        "title": "VS Code Wallpaper: Show Responsive Test Script"
      },
      {
        "command": "vscodeWallpaper.enableAutomatic",
        "title": "VS Code Wallpaper: Enable Automatic Wallpaper"
      },
      {
        "command": "vscodeWallpaper.disableAutomatic",
        "title": "VS Code Wallpaper: Disable Automatic Wallpaper"
      }
    ],
    "configuration": {
      "title": "VS Code Wallpaper",
      "properties": {
        "vscodeWallpaper.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "壁紙用 CSS の生成を有効にする。VS Code 本体への自動適用は別途有効にする。"
        },
        "vscodeWallpaper.image": {
          "type": [
            "string",
            "null"
          ],
          "default": "",
          "scope": "window",
          "description": "通常表示する背景画像。https://、file:///、絶対パス、~/、./ などを指定する。null または空文字で非表示。"
        },
        "vscodeWallpaper.alternateImage": {
          "type": [
            "string",
            "null"
          ],
          "default": "",
          "scope": "window",
          "description": "縦長・狭い画面などで使う代替画像。空文字の場合は切り替えない。"
        },
        "vscodeWallpaper.switchMode": {
          "type": "string",
          "enum": [
            "orientation",
            "aspect-ratio",
            "width"
          ],
          "default": "orientation",
          "scope": "window",
          "description": "代替画像への切り替え条件。orientation は縦長、aspect-ratio は指定した縦横比以下、width は指定した幅以下。"
        },
        "vscodeWallpaper.maxAspectRatio": {
          "type": "string",
          "default": "16/10",
          "pattern": "^[0-9]+\\s*/\\s*[0-9]+$",
          "scope": "window",
          "description": "switchMode が aspect-ratio のときに代替画像へ切り替える縦横比。例: 16/10。"
        },
        "vscodeWallpaper.maxWidth": {
          "type": "integer",
          "default": 1400,
          "minimum": 1,
          "maximum": 10000,
          "scope": "window",
          "description": "switchMode が width のときに代替画像へ切り替える最大幅（CSS ピクセル）。"
        },
        "vscodeWallpaper.tint": {
          "type": "string",
          "default": "#FFFFFF",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "scope": "window",
          "description": "背景画像に乗算する色。#FFFFFF（白）なら画像の色を変えない。"
        },
        "vscodeWallpaper.opacity": {
          "type": "object",
          "scope": "window",
          "default": {
            "editor": 0.7,
            "sidebar": 0.85,
            "panel": 0.85,
            "auxiliaryBar": 0.85,
            "chrome": 0.92,
            "gap": 0
          },
          "additionalProperties": false,
          "properties": {
            "editor": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "コードなどを編集する中央の領域。"
            },
            "sidebar": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Explorer・検索などを表示する主サイドバー。"
            },
            "panel": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "ターミナル・問題一覧などを表示するパネル。"
            },
            "auxiliaryBar": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "チャットなどを表示する補助サイドバー。"
            },
            "chrome": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "タイトルバー、ステータスバー、アクティビティバーの3か所。"
            },
            "gap": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "浮動パネルを使う画面で、各パネルの間と外周にある余白。通常配置では対象外。"
            }
          },
          "description": "各領域の背景色の不透明度。0 は透明、1 は不透明。文字は透過しない。項目ごとの対象領域は下記を参照。"
        },
        "vscodeWallpaper.backgroundColors": {
          "type": "object",
          "scope": "window",
          "default": {
            "editor": "theme",
            "sidebar": "theme",
            "panel": "theme",
            "auxiliaryBar": "theme",
            "chrome": "theme",
            "gap": "theme"
          },
          "additionalProperties": false,
          "properties": {
            "editor": {
              "type": "string",
              "pattern": "^(theme|#[0-9a-fA-F]{6})$",
              "description": "コードなどを編集する中央の領域。"
            },
            "sidebar": {
              "type": "string",
              "pattern": "^(theme|#[0-9a-fA-F]{6})$",
              "description": "Explorer・検索などを表示する主サイドバー。"
            },
            "panel": {
              "type": "string",
              "pattern": "^(theme|#[0-9a-fA-F]{6})$",
              "description": "ターミナル・問題一覧などを表示するパネル。"
            },
            "auxiliaryBar": {
              "type": "string",
              "pattern": "^(theme|#[0-9a-fA-F]{6})$",
              "description": "チャットなどを表示する補助サイドバー。"
            },
            "chrome": {
              "type": "string",
              "pattern": "^(theme|#[0-9a-fA-F]{6})$",
              "description": "タイトルバー、ステータスバー、アクティビティバーの3か所。"
            },
            "gap": {
              "type": "string",
              "pattern": "^(theme|#[0-9a-fA-F]{6})$",
              "description": "浮動パネルを使う画面で、各パネルの間と外周にある余白。通常配置では対象外。"
            }
          },
          "description": "各領域の背景色。theme は現在の VS Code のテーマ色を使い、#RRGGBB で独自の色を指定できる。"
        },
        "vscodeWallpaper.minimapOpacity": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "minimum": 0,
          "maximum": 1,
          "scope": "window",
          "description": "ミニマップの描画全体の不透明度。縮小コードも薄くなるが、スクロールバーのつまみは対象外。null は VS Code 標準表示。"
        },
        "vscodeWallpaper.stickyScrollBlur": {
          "type": "integer",
          "default": 12,
          "minimum": 0,
          "maximum": 30,
          "scope": "window",
          "description": "エディタ上部の固定表示コード（Sticky Scroll）の背後をぼかす強さ（px）。固定文字はぼかさない。0 で無効。"
        },
        "vscodeWallpaper.suggestWidget": {
          "type": "object",
          "scope": "window",
          "default": {
            "backgroundColor": "theme",
            "opacity": 0.85,
            "blur": 12
          },
          "additionalProperties": false,
          "properties": {
            "backgroundColor": {
              "type": "string",
              "pattern": "^(theme|#[0-9a-fA-F]{6})$",
              "description": "補完候補一覧と説明欄の背景色。theme は VS Code の補完用テーマ色を使用し、#RRGGBB で独自の色を指定する。"
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "補完パネルの背景色の不透明度。0 は透明、1 は不透明。候補の文字や選択行は透過させない。"
            },
            "blur": {
              "type": "integer",
              "minimum": 0,
              "maximum": 30,
              "description": "補完パネルの背後の文字や画像をぼかす強さ（px）。0 はぼかしなし。"
            }
          },
          "description": "入力補完の候補一覧と説明欄の背景色・不透明度・背後のぼかしを設定する。"
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/takashit16833/dotfiles.git"
  },
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ]
}

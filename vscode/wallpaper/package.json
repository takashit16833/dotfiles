{
  "name": "vscode-wallpaper",
  "displayName": "VS Code Wallpaper",
  "description": "Generate a responsive, multiply-blended VS Code wallpaper stylesheet without patching VS Code.",
  "version": "0.7.1",
  "publisher": "takashit16833",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "vscodeWallpaper.preview",
        "title": "VS Code Wallpaper: Preview"
      },
      {
        "command": "vscodeWallpaper.showCss",
        "title": "VS Code Wallpaper: Show Generated CSS"
      },
      {
        "command": "vscodeWallpaper.showWorkbenchScript",
        "title": "VS Code Wallpaper: Show Temporary Workbench Script"
      },
      {
        "command": "vscodeWallpaper.showRemoveScript",
        "title": "VS Code Wallpaper: Show Remove Script"
      },
      {
        "command": "vscodeWallpaper.showDiagnosticsScript",
        "title": "VS Code Wallpaper: Show Read-only Workbench Diagnostics"
      },
      {
        "command": "vscodeWallpaper.showResponsiveTestScript",
        "title": "VS Code Wallpaper: Show Responsive Test Script"
      },
      {
        "command": "vscodeWallpaper.enableAutomatic",
        "title": "VS Code Wallpaper: Enable Automatic Wallpaper"
      },
      {
        "command": "vscodeWallpaper.disableAutomatic",
        "title": "VS Code Wallpaper: Disable Automatic Wallpaper"
      }
    ],
    "configuration": {
      "title": "VS Code Wallpaper",
      "properties": {
        "vscodeWallpaper.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "Enable CSS generation and preview. Does not modify VS Code application files."
        },
        "vscodeWallpaper.image": {
          "type": [
            "string",
            "null"
          ],
          "default": "",
          "scope": "window",
          "description": "Wallpaper image URL or local path. Null or empty means no wallpaper unless a workspace overrides it."
        },
        "vscodeWallpaper.alternateImage": {
          "type": [
            "string",
            "null"
          ],
          "default": "",
          "scope": "window",
          "description": "Optional image for portrait, low aspect ratio, or narrow windows; empty means always use the default image."
        },
        "vscodeWallpaper.switchMode": {
          "type": "string",
          "enum": [
            "orientation",
            "aspect-ratio",
            "width"
          ],
          "default": "orientation",
          "scope": "window",
          "description": "Switch between portrait and landscape, a chosen aspect ratio, or window width."
        },
        "vscodeWallpaper.maxAspectRatio": {
          "type": "string",
          "default": "16/10",
          "pattern": "^[0-9]+\\s*/\\s*[0-9]+$",
          "scope": "window",
          "description": "Use the alternate image at or below this window aspect ratio."
        },
        "vscodeWallpaper.maxWidth": {
          "type": "integer",
          "default": 1400,
          "minimum": 1,
          "maximum": 10000,
          "scope": "window",
          "description": "Use the alternate image at or below this window width in CSS pixels."
        },
        "vscodeWallpaper.tint": {
          "type": "string",
          "default": "#FFFFFF",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "scope": "window",
          "description": "Color multiplied with the image; white leaves the original image colors unchanged."
        },
        "vscodeWallpaper.opacity": {
          "type": "object",
          "scope": "window",
          "default": {
            "editor": 0.7,
            "sidebar": 0.85,
            "panel": 0.85,
            "auxiliaryBar": 0.85,
            "chrome": 0.92,
            "gap": 0
          },
          "additionalProperties": false,
          "properties": {
            "editor": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "sidebar": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "panel": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "auxiliaryBar": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "chrome": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "gap": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "description": "Background opacity per area. The floating-card gutter uses gap (default 0, fully transparent). Text remains opaque."
        },
        "vscodeWallpaper.backgroundColors": {
          "type": "object",
          "scope": "window",
          "default": {
            "editor": "theme",
            "sidebar": "theme",
            "panel": "theme",
            "auxiliaryBar": "theme",
            "chrome": "theme",
            "gap": "theme"
          },
          "additionalProperties": false,
          "properties": {
            "editor": {
              "type": "string",
              "pattern": "^(theme|#[0-9a-fA-F]{6})$"
            },
            "sidebar": {
              "type": "string",
              "pattern": "^(theme|#[0-9a-fA-F]{6})$"
            },
            "panel": {
              "type": "string",
              "pattern": "^(theme|#[0-9a-fA-F]{6})$"
            },
            "auxiliaryBar": {
              "type": "string",
              "pattern": "^(theme|#[0-9a-fA-F]{6})$"
            },
            "chrome": {
              "type": "string",
              "pattern": "^(theme|#[0-9a-fA-F]{6})$"
            },
            "gap": {
              "type": "string",
              "pattern": "^(theme|#[0-9a-fA-F]{6})$"
            }
          },
          "description": "Background colors per area, including floating-card gutters. Use 'theme' to follow the active theme or a custom #RRGGBB."
        },
        "vscodeWallpaper.minimapOpacity": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "minimum": 0,
          "maximum": 1,
          "scope": "window",
          "description": "Optional minimap canvas opacity. Also fades minimap code, not the scrollbar thumb. Null preserves VS Code's default."
        },
        "vscodeWallpaper.stickyScrollBlur": {
          "type": "integer",
          "default": 12,
          "minimum": 0,
          "maximum": 30,
          "scope": "window",
          "description": "Blur the code behind Sticky Scroll (pixels) without blurring the pinned text. Set 0 to disable."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/takashit16833/dotfiles.git"
  },
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ]
}

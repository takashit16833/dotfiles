#!/usr/bin/env bash

# Harlequin本体はHomebrew管理のまま、dotfilesのテーマだけ起動時に追加する。
set -euo pipefail

XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
THEME_PYTHON_PATH="$XDG_CONFIG_HOME/harlequin/python"

if ! command -v harlequin >/dev/null 2>&1; then
  printf '%s\n' 'harlequin: command not found; install it with Homebrew first' >&2
  exit 1
fi

if [[ ! -f "$THEME_PYTHON_PATH/sitecustomize.py" ]]; then
  printf '%s\n' "Retro Hacker Blue theme not found: $THEME_PYTHON_PATH/sitecustomize.py" >&2
  exit 1
fi

# Python標準のsitecustomize読み込みを利用し、Harlequin本体は変更しない。
export PYTHONPATH="$THEME_PYTHON_PATH${PYTHONPATH:+:$PYTHONPATH}"

exec harlequin "$@"

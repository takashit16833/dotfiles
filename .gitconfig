# Portable Git settings shared across Macs.
# Machine-specific identity and authentication are intentionally kept out of this file.

[core]
    quotepath = false

[init]
    defaultBranch = main

[pull]
    ff = only

[user]
    useConfigOnly = true

# git-delta の UI と構文色を Retro Hacker Blue に統一する。
# 元テーマの赤系 (#FF5A5A) は、この dotfiles 全体の方針に合わせて #FF4DE1 に置換する。
[delta]
    dark = true
    features = retro-hacker-blue

[delta "retro-hacker-blue"]
    # VS Code 本家の tokenColors を移植した bat theme を構文色に使う。
    syntax-theme = "Retro Hacker Blue"

    # True Retro Hacker Blue Diff:
    # VS Code 標準の赤 / 緑 Diff 色には寄せず、テーマ自身の色体系だけで表現する。
    # 追加 = Blue、削除 = Cyber Pink。どちらもコード本来の構文色は維持する。
    # 行内で実際に変わった部分だけ、同系色の一段濃い背景で強調する。
    minus-style = syntax "#1F0A2A"
    minus-emph-style = syntax "#401445"
    plus-style = syntax "#0C162E"
    plus-emph-style = syntax "#182C4C"
    zero-style = syntax

    # side-by-side 表示などで使われる行番号。
    # 追加は主役の Blue、削除は Cyber Pink、通常行は控えめな Blue。
    line-numbers-left-style = "#153A75"
    line-numbers-right-style = "#153A75"
    line-numbers-minus-style = "#FF4DE1"
    line-numbers-plus-style = "#5EAFFF"
    line-numbers-zero-style = "#316CBD"

    # ファイル見出し。横線は増やさず、文字色だけで区切る。
    file-style = "#5EAFFF" bold
    file-decoration-style = none

    # @@ ... @@ の hunk 見出し。
    # modified の役割を持つ Gold を行番号に使い、背景はテーマの暗い Section Blue にする。
    hunk-header-style = file line-number syntax "#001947"
    hunk-header-file-style = "#7CBEFF"
    hunk-header-line-number-style = "#FFD700"
    hunk-header-decoration-style = none

    # git log -p などで表示される commit 見出し。
    commit-style = "#7CBEFF" bold
    commit-decoration-style = none

    # 折り返しやタブなど、Delta が追加する補助表示。
    inline-hint-style = "#83B9FF"

    # 空白エラーは背景を塗りつぶさず、置換後のエラー色で明示する。
    whitespace-error-style = "#FF4DE1" underline

[include]
    path = ~/.gitconfig.local

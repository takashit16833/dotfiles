# Portable Git settings shared across Macs.
# Machine-specific identity and authentication are intentionally kept out of this file.

[core]
    quotepath = false
    pager = delta

[init]
    defaultBranch = main

[pull]
    ff = only

[user]
    useConfigOnly = true

[include]
    path = ~/.gitconfig.local

[delta]
    navigate = true
    side-by-side = false
    line-numbers = true

# Lazygit の競合解消メニューから VS Code のマージエディタを開く。
[merge]
    tool = vscode

[mergetool "vscode"]
    cmd = code --wait --merge \"$REMOTE\" \"$LOCAL\" \"$BASE\" \"$MERGED\"

{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "dotfiles-commands",
  "title": "Dotfiles Commands",
  "description": "Personal Raycast commands managed by the dotfiles repository.",
  "icon": "icon.png",
  "author": "takashit16833",
  "license": "MIT",
  "categories": [
    "Developer Tools"
  ],
  "platforms": [
    "macOS"
  ],
  "commands": [
    {
      "name": "search-repositories",
      "title": "GitHub Repositories",
      "description": "Search GitHub repositories available through the authenticated gh account.",
      "mode": "view",
      "keywords": [
        "gh",
        "github"
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.101.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.0.4",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "allowScripts": {
    "esbuild": true
  },
  "scripts": {
    "build": "ray build -e dist -o dist",
    "dev": "ray develop",
    "lint": "ray lint"
  }
}

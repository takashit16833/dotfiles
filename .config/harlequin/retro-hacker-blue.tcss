/* Harlequin用 Retro Hacker Blue の微調整。 */

/*
 * ANSI passthroughで端末の既定背景をそのまま使う。
 * Retro Hacker Blueの前景色や状態色だけを個別に重ねる。
 */
Screen,
#main_panel,
DataCatalog,
EditorCollection,
ResultsViewer,
ResultsViewer ContentSwitcher,
ResultsViewer TabPane,
RunQueryBar,
RunQueryBar Horizontal,
CodeEditor,
CodeEditor TextArea,
ResultsTable,
Lazy {
    background: ansi_default;
}

/* Data Catalog内部も端末背景をそのまま見せる。 */
DataCatalog DatabaseTree,
DataCatalog FileTree,
DataCatalog S3Tree {
    background: ansi_default;
    background-tint: transparent;
}

DataCatalog DatabaseTree:focus,
DataCatalog FileTree:focus,
DataCatalog S3Tree:focus {
    background-tint: transparent;
}

/* Query Editor / Resultsの内部widgetが持つ既定背景も消す。 */
CodeEditor TextArea {
    background: ansi_default;
}

ResultsTable {
    background: ansi_default;
}

ResultsTable > .datatable--odd-row,
ResultsTable > .datatable--even-row,
ResultsTable > .datatable--header,
ResultsTable > .datatable--fixed {
    background: ansi_default;
}

/* ペインタイトルの背景は描画しない。 */
DataCatalog,
EditorCollection,
FooterContainer > Input,
KeysPanel,
ResultsViewer,
HistoryScreen #history_filter,
HistoryScreen #history_filter_controls > Select,
HistoryScreen HistoryList,
HistoryScreen QueryPreview,
Lazy {
    border: round #153A75;
    border-title-color: #153A75;
    border-title-background: ansi_default;
}

/* Yaziのcurrent行と同じ見た目に揃える。 */
.text-area--cursor-line,
.text-area--cursor-gutter {
    background: #061536;
}

/*
 * ANSI modeではTextual本体がcursorへ reverse を付けるため、
 * HarlequinのTextAreaPlusまで具体化してピンクの実カーソルを維持する。
 */
CodeEditor TextAreaPlus:focus .text-area--cursor {
    background: #FF4DE1;
    color: #010111;
    text-style: none;
}

/* 一覧系widgetの選択色をYaziのcurrent行に揃える。 */
ResultsTable > .datatable--cursor,
ResultsTable:focus > .datatable--cursor,
CompletionList > .option-list--option-highlighted,
HistoryScreen HistoryList > .option-list--option-highlighted {
    background: #061536;
    color: #A6CAFF;
    text-style: bold;
}

/* Tx: Auto / Limitの行は背景を描画しない。 */
RunQueryBar,
RunQueryBar Horizontal,
RunQueryBar Input,
RunQueryBar Checkbox,
RunQueryBar Checkbox:focus > .toggle--label,
RunQueryBar.non-responsive Checkbox,
RunQueryBar.non-responsive Input {
    background: ansi_default;
    background-tint: transparent;
}

/* 実行ボタンは背景透過の影響を受けないよう色を明示する。 */
RunQueryBar Button#run_query {
    background: #5EAFFF;
    color: #010111;
}

RunQueryBar Button#run_query:hover {
    background: #87CEEB;
    color: #010111;
}

RunQueryBar Button#cancel_query {
    background: #FF4DE1;
    color: #010111;
}

/* Yaziのstatusと同じ濃紺をフッターだけに残す。 */
Footer,
FooterKey,
FooterKey .footer-key--key,
FooterKey .footer-key--description {
    background: #000E2F;
}

Footer {
    color: #316CBD;
}

FooterKey {
    color: #5EAFFF;
}

FooterKey .footer-key--key {
    color: #5EAFFF;
}

FooterKey .footer-key--description {
    color: #316CBD;
}

/* LimitのチェックボックスはANSI既定色を使わず、Yazi系の選択色に揃える。 */
RunQueryBar Checkbox#limit_checkbox {
    background: ansi_default;
    background-tint: transparent;
    color: #5EAFFF;
}

RunQueryBar Checkbox#limit_checkbox > .toggle--button {
    background: #061536;
    color: #316CBD;
    text-style: none;
}

RunQueryBar Checkbox#limit_checkbox.-on > .toggle--button {
    background: #061536;
    color: #A6CAFF;
    text-style: bold;
}

RunQueryBar Checkbox#limit_checkbox:focus > .toggle--label {
    background: ansi_default;
    background-tint: transparent;
    color: #5EAFFF;
    text-style: none;
}

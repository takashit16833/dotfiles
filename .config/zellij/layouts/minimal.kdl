// Zellij 自身の名前・session・mode は表示せず、tab だけを 1 行で表示する。
// zjstatus 0.24.0 の focused_pane_title を使い、各 tab は現在の pane title を表示する。
layout {
    default_tab_template {
        children

        pane size=1 borderless=true {
            plugin location="https://github.com/dj95/zjstatus/releases/download/v0.24.0/zjstatus.wasm" {
                format_left "{tabs}"
                format_center ""
                format_right ""
                format_space ""

                border_enabled "false"

                tab_normal            "#[fg=#4C9EEB] {focused_pane_title} "
                tab_normal_fullscreen "#[fg=#4C9EEB] {focused_pane_title} "
                tab_normal_sync       "#[fg=#4C9EEB] {focused_pane_title} "
                tab_active            "#[fg=#FF4DE1,bold] {focused_pane_title} "
                tab_active_fullscreen "#[fg=#FF4DE1,bold] {focused_pane_title} "
                tab_active_sync       "#[fg=#FF4DE1,bold] {focused_pane_title} "
                tab_rename            "#[fg=#FF4DE1,bold] {name} "
                tab_separator         "  "
            }
        }
    }
}

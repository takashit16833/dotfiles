// 起動直後は lazygit だけを全面表示し、必要になったら通常の Zellij pane を追加する。
// Homebrew の PATH は zsh の login startup で設定されるため、login zsh 経由で lazygit を起動する。
layout {
    default_tab_template {
        children

        pane size=1 borderless=true {
            plugin location="zjstatus"
        }
    }

    tab {
        pane name="lazygit" command="/bin/zsh" {
            args "-lc" "exec lazygit"
        }
    }
}

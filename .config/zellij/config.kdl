// Kitty の配色に合わせ、Zellij の pane frame / 分割線は普段は暗い青、
// Pane mode などの操作中だけ明るい青で強調する。
simplified_ui true
default_layout "minimal"
pane_frame_style "full"

themes {
    retro-hacker-blue {
        frame_unselected {
            base 0 24 74
            background 0
            emphasis_0 0 24 74
            emphasis_1 0 24 74
            emphasis_2 0 24 74
            emphasis_3 0 24 74
        }

        frame_selected {
            base 0 24 74
            background 0
            emphasis_0 0 24 74
            emphasis_1 0 24 74
            emphasis_2 0 24 74
            emphasis_3 0 24 74
        }

        frame_highlight {
            base 76 158 235
            background 0
            emphasis_0 76 158 235
            emphasis_1 76 158 235
            emphasis_2 76 158 235
            emphasis_3 76 158 235
        }
    }
}

theme "retro-hacker-blue"

// 複数 layout から同じ tab bar を再利用できるよう、zjstatus の設定を alias に集約する。
// GUI アプリの tab に近い見た目にし、active は明るい青、inactive は pane frame と同じ暗い青にする。
plugins {
    zjstatus location="https://github.com/dj95/zjstatus/releases/download/v0.24.0/zjstatus.wasm" {
        format_left "{tabs}"
        format_center ""
        format_right ""
        format_space "#[bg=#010111]"

        border_enabled "false"

        tab_normal            "#[fg=#4C9EEB,bg=#00184A] {focused_pane_title} #[bg=#010111]"
        tab_normal_fullscreen "#[fg=#4C9EEB,bg=#00184A] {focused_pane_title} #[bg=#010111]"
        tab_normal_sync       "#[fg=#4C9EEB,bg=#00184A] {focused_pane_title} #[bg=#010111]"
        tab_active            "#[fg=#010111,bg=#4C9EEB,bold] {focused_pane_title} #[bg=#010111]"
        tab_active_fullscreen "#[fg=#010111,bg=#4C9EEB,bold] {focused_pane_title} #[bg=#010111]"
        tab_active_sync       "#[fg=#010111,bg=#4C9EEB,bold] {focused_pane_title} #[bg=#010111]"
        tab_rename            "#[fg=#010111,bg=#4C9EEB,bold] {name} #[bg=#010111]"
        tab_separator         " "
    }
}

// Kitty は Cmd + Option + Left / Right を Alt-Shift-Left / Right として渡す。
// Option + Left / Right 単体の shell word navigation を残したまま、Zellij tab を直接移動する。
keybinds {
    // Ctrl+S は LazyGit など Terminal application 側で利用するため、
    // Zellij の既定 Scroll mode キーから外す。
    unbind "Ctrl s"

    // Kitty の Option + Right は zsh の forward-word 用に Alt-f を送る。
    // Zellij 既定の Alt-f (floating pane toggle) を外し、shell へそのまま通す。
    unbind "Alt f"

    tab {
        // Tab mode 中も Ctrl+T を shell 用に空け、Alt+T で Normal mode へ戻る。
        unbind "Ctrl t"
        bind "Alt t" { SwitchToMode "Normal"; }
    }

    shared_except "scroll" "locked" {
        // Scroll mode は Ctrl+S の代わりに Alt+S で開く。
        bind "Alt s" { SwitchToMode "Scroll"; }
    }

    shared_except "tab" "locked" {
        // 既定の Ctrl+T と同じ mode 群で解除し、zsh の transpose-words より Alt+T を優先する。
        unbind "Ctrl t"
        bind "Alt t" { SwitchToMode "Tab"; }
    }

    shared_except "locked" {
        bind "Alt Shift Left" { GoToPreviousTab; }
        bind "Alt Shift Right" { GoToNextTab; }
    }
}

// About Zellij の startup tip は普段使いでは不要なので表示しない。
show_startup_tips false

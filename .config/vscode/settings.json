{
    // すべでの文字を対象にする（規定は前方一致）
    "quickJump.matchMode": "anywhere",
    // 開いているファイル内の単語を補完候補にする
    "editor.wordBasedSuggestions": "allDocuments",
    // コード部分だけ自動補完する
    "editor.quickSuggestions": {
        "other": "on",
        "comments": "off",
        "strings": "off"
    },
    // 単語ベースの候補を表示する
    "editor.suggest.showWords": true,
    // 近くで使われている単語を少し優先する
    "editor.suggest.localityBonus": true,
    // Noctis Blue の透過版を標準テーマとして利用する。
    "workbench.colorTheme": "Noctis Blue Transparent",
    // エディタのフォントサイズ
    "editor.fontSize": 13,
    // エディタのフォント
    "editor.fontFamily": "'Menlo', 'BIZ UDGothic', monospace",
    "terminal.integrated.fontFamily": "'Menlo', 'BIZ UDGothic', monospace",
    // 行間
    "editor.lineHeight": 1.35,
    // スムースアニメーション
    "editor.smoothScrolling": true,
    "editor.cursorSmoothCaretAnimation": "on",
    "workbench.list.smoothScrolling": true,
    "terminal.integrated.smoothScrolling": true,
    // 複数行のペースト時に警告を出さない
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    // カレントコマンドがエリア上部に固定されるのを止める
    "terminal.integrated.stickyScroll.enabled": false,
    // Enterでは補完を確定しない
    "editor.acceptSuggestionOnEnter": "off",
    // Minimapの現在地ハイライトを常に有効にする
    "editor.minimap.showSlider": "always",
    // 現在行の背景を本文と行番号の両方で強調する
    "editor.renderLineHighlight": "all",
    // JSON / JSONC は保存時に VS Code 標準フォーマッタで整形する。
    "[json]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[jsonc]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    // Markdown は VS Code 内蔵のリッチ Markdown Editor で開く。
    "workbench.editorAssociations": {
        "*.md": "vscode.markdown.editor"
    },
    // GitHub 等のリンクをカード化せず、通常の Markdown リンクとして表示する。
    "markdown.experimental.richLinks.enabled": false,
    "accessibility.signals.format": {
        "sound": "userGesture",
        "announcement": "never"
    },
    "accessibility.signals.save": {
        "sound": "userGesture",
        "announcement": "never"
    },
    "accessibility.signals.voiceRecordingStarted": {
        "sound": "auto"
    },
    "accessibility.signals.positionHasError": {
        "sound": "off",
        "announcement": "auto"
    },
    "accessibility.signals.positionHasWarning": {
        "sound": "off",
        "announcement": "auto"
    },
    "editor.accessibilitySupport": "off",
    "workbench.activityBar.location": "hidden",
    "workbench.navigationControl.enabled": false,
    "workbench.layoutControl.enabled": false,
    "chat.titleBar.openInAgentsWindow.enabled": false,
    "workbench.browser.showInTitleBar": false,
    "window.commandCenter": false,
    "workbench.editor.editorActionsLocation": "hidden",
    "chat.titleBar.signIn.enabled": false,
    // 背景 -----------------------------------
    // Noctis Blue の背景画像の有効・無効
    "noctisBlue.wallpaper.enabled": true,
    // メインの背景画像
    "noctisBlue.wallpaper.image": "/Users/takashi/workspace/pictures/05.webp",
    // 2枚目の画像（不要なら空文字）
    "noctisBlue.wallpaper.alternateImage": "/Users/takashi/workspace/pictures/05.webp",
    // 画像の切り替え方法
    "noctisBlue.wallpaper.switchMode": "orientation",
    // 画像に乗算する色（白なら元画像の色を維持）
    "noctisBlue.wallpaper.tint": "#7085B0",
    "terminal.integrated.enableImages": true,
    // Noctis Blue の領域別透過
    "noctisBlue.opacity": {
        "editor": 0.88,
        "gutter": 0.5,
        "minimap": 0.5,
        "tabs": 0.3,
        "breadcrumbs": 0.3,
        "sidebar": 0.90,
        "panel": 0.85,
        "auxiliaryBar": 0.86,
        "chrome": 0.93,
        "gap": 0.91
    }
}
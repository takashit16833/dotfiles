{
    // 開いているファイル内の単語を補完候補にする
    "editor.wordBasedSuggestions": "allDocuments",
    // コード部分だけ自動補完する
    "editor.quickSuggestions": {
        "other": "on",
        "comments": "off",
        "strings": "off"
    },
    // 単語ベースの候補を表示する
    "editor.suggest.showWords": true,
    // 近くで使われている単語を少し優先する
    "editor.suggest.localityBonus": true,
    // Noctis Blue の透過版を標準テーマとして利用する。
    "workbench.colorTheme": "Noctis Blue Transparent",
    // エディタのフォントサイズ
    "editor.fontSize": 12.5,
    // エディタのフォント
    "editor.fontFamily": "'Menlo', 'BIZ UDGothic', monospace",
    "terminal.integrated.fontFamily": "'Menlo', 'BIZ UDGothic', monospace",
    // スムースアニメーション
    "editor.smoothScrolling": true,
    "editor.cursorSmoothCaretAnimation": "on",
    "workbench.list.smoothScrolling": true,
    "terminal.integrated.smoothScrolling": true,
    // 複数行のペースト時に警告を出さない
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    // カレントコマンドがエリア上部に固定されるのを止める
    "terminal.integrated.stickyScroll.enabled": false,
    // Enterでは補完を確定しない
    "editor.acceptSuggestionOnEnter": "off",
    // Minimapの現在地ハイライトを常に有効にする
    "editor.minimap.showSlider": "always",
    // JSON / JSONC は保存時に VS Code 標準フォーマッタで整形する。
    "[json]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[jsonc]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    // マークダウンはプレビューで開く
    "workbench.editorAssociations": {},
    // Markdown Live Preview の配色を試す。既定の Markdown Preview は変更しない。
    "mdLivePreview.enabledStyles": [
        "retro-hacker-blue.css"
    ],
    // Markdown の装飾と階層インデントは自作拡張機能で適用する。
    // Text Marker は暗い背景でも色を判別しやすいよう、色相を広く散らす。
    // Noctis Blue の Gold / Blue / Purple / Orange と Cyber Pink に、
    // テーマの雰囲気になじむ Hacker Green を加える。Cyan は単語ハイライトと競合するため避ける。
    "textmarker.highlightColors": [
        "#FFD700",
        "#39FF88",
        "#5EAFFF",
        "#B07CFF",
        "#FF4DE1",
        "#FFA500"
    ],
    "textmarker.defaultHighlightColor": "#8A5EC0",
    "textmarker.defaultHighlightOpacity": 0.36,
    "textmarker.enableWholeMatch": true,
    "textmarker.autoSelectDistinctiveTextColor": false,
    "textmarker.useHighlightColorOnRuler": true,
    // テーマ固有の配色は Noctis Blue 本体で管理する。
    // ここでは各拡張固有の色だけを設定する。
    "workbench.colorCustomizations": {
        "quickJump.hintBackground": "#FF4DE1CC",
        "quickJump.hintForeground": "#00184A"
    },
    "accessibility.signals.format": {
        "sound": "userGesture",
        "announcement": "never"
    },
    "accessibility.signals.save": {
        "sound": "userGesture",
        "announcement": "never"
    },
    "accessibility.signals.voiceRecordingStarted": {
        "sound": "auto"
    },
    "accessibility.signals.positionHasError": {
        "sound": "off",
        "announcement": "auto"
    },
    "accessibility.signals.positionHasWarning": {
        "sound": "off",
        "announcement": "auto"
    },
    "editor.accessibilitySupport": "off",
    "workbench.activityBar.location": "hidden",
    "workbench.navigationControl.enabled": false,
    "workbench.layoutControl.enabled": false,
    "chat.titleBar.openInAgentsWindow.enabled": false,
    "workbench.browser.showInTitleBar": false,
    "window.commandCenter": false,
    "workbench.editor.editorActionsLocation": "hidden",
    "chat.titleBar.signIn.enabled": false,
    // 背景 -----------------------------------
    // 壁紙機能の有効・無効
    "vscodeWallpaper.enabled": true,
    // メインの背景画像
    "vscodeWallpaper.image": "/Users/suzukitakashi/Desktop/warehouse/wall/11.png",
    // 2枚目の画像（不要なら空文字）
    "vscodeWallpaper.alternateImage": "/Users/suzukitakashi/Desktop/warehouse/wall/10.png",
    // 画像の切り替え方法
    "vscodeWallpaper.switchMode": "orientation",
    // 画像に乗算する色（白なら元画像の色を維持）
    "vscodeWallpaper.tint": "#FFFFFF",
    // 領域別の背景色と透過は Noctis Blue が担当する。
    "noctisBlue.opacity": {
        "editor": 0.91,
        "sidebar": 0.93,
        "panel": 0.94,
        "auxiliaryBar": 0.86,
        "chrome": 0.93,
        "gap": 0.91
    },
    "terminal.integrated.enableImages": true,
    "workbench.colorTheme": "Noctis Blue Transparent",
}
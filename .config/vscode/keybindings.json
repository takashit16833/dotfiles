[
    // タブグループが1つだけ
    // → 右に新しいグループを作って Source を開く
    {
        "key": "cmd+k v",
        "command": "runCommands",
        "when": "activeCustomEditorId == 'vscode.markdown.preview.editor' && !multipleEditorGroups",
        "args": {
            "commands": [
                "workbench.action.splitEditorRight",
                "markdown.reopenAsSource"
            ]
        }
    },
    // 複数グループあり ＆ 今いるのが最後ではない
    // → 右隣の既存グループに Source を開く
    {
        "key": "cmd+k v",
        "command": "runCommands",
        "when": "activeCustomEditorId == 'vscode.markdown.preview.editor' && multipleEditorGroups && !activeEditorGroupLast",
        "args": {
            "commands": [
                "workbench.action.splitEditorRight",
                "workbench.action.moveEditorToNextGroup",
                "markdown.reopenAsSource"
            ]
        }
    },
    // 複数グループあり ＆ 今いるのが最後
    // → 左隣の既存グループに Source を開く
    {
        "key": "cmd+k v",
        "command": "runCommands",
        "when": "activeCustomEditorId == 'vscode.markdown.preview.editor' && multipleEditorGroups && activeEditorGroupLast",
        "args": {
            "commands": [
                "workbench.action.splitEditorLeft",
                "workbench.action.moveEditorToPreviousGroup",
                "markdown.reopenAsSource"
            ]
        }
    },
    // インライン補完を表示させる
    {
        "key": "alt+/",
        "command": "editor.action.triggerSuggest",
        "when": "editorHasCompletionItemProvider && textInputFocus && !editorReadonly && !suggestWidgetVisible"
    },
    {
        "key": "alt+escape",
        "command": "-editor.action.triggerSuggest",
        "when": "editorHasCompletionItemProvider && textInputFocus && !editorReadonly && !suggestWidgetVisible"
    },
    // エディタを上のグループへ移動する。
    // Ctrl+Cmd+←/→ の上下版として使う想定。
    {
        "key": "ctrl+cmd+up",
        "command": "workbench.action.moveEditorToAboveGroup"
    },
    // エディタを下のグループへ移動する。
    // Open Definition to the Side で横に開いた定義元を下へ送る時に便利。
    {
        "key": "ctrl+cmd+down",
        "command": "workbench.action.moveEditorToBelowGroup"
    },
    // Text Marker: カーソル下の単語、または選択範囲をマーク / 解除する。
    {
        "key": "cmd+k h",
        "command": "textmarker.toggleHighlight",
        "when": "editorTextFocus"
    },
    // Text Marker: 現在のマークの次の出現箇所へ移動する。
    {
        "key": "cmd+f6",
        "command": "textmarker.goToNextHighlight",
        "when": "editorTextFocus"
    },
    // Text Marker: 現在のマークの前の出現箇所へ移動する。
    {
        "key": "shift+cmd+f6",
        "command": "textmarker.goToPreviousHighlight",
        "when": "editorTextFocus"
    },
    // Text Marker: すべてのマークをまとめて解除する。
    {
        "key": "cmd+k shift+h",
        "command": "textmarker.clearAllHighlight",
        "when": "editorTextFocus"
    },
    // Jump to Hint: Search を F13 一発で起動する。
    // 文字列で候補を絞ってからヒントを選ぶ、普段使いのジャンプ操作として使う。
    {
        "key": "f13",
        "command": "jumpToHint.jumpBySearch",
        "when": "editorTextFocus"
    },
    // Explorer: 選択中のファイルを開いたあと、そのまま Sidebar を閉じる。
    // フォルダ上では発火しないため、ツリーを辿っている途中では Sidebar は残る。
    // Cmd+Shift+E で Explorer を開く → Cmd+Down でファイルを開く → Explorer が消える、という流れにする。
    {
        "key": "cmd+down",
        "command": "runCommands",
        "when": "filesExplorerFocus && !explorerResourceIsFolder",
        "args": {
            "commands": [
                "list.select",
                "workbench.action.toggleSidebarVisibility"
            ]
        }
    },
    // Explorer: 選択中のフォルダ配下（ファイル選択時は同じ階層）に新しいファイルを作成する。
    // Explorer 以外では VS Code 標準の Cmd+N（Untitled File）をそのまま利用できる。
    {
        "key": "cmd+n",
        "command": "explorer.newFile",
        "when": "filesExplorerFocus && !inputFocus"
    },
    // Explorer: 選択中のフォルダ配下（ファイル選択時は同じ階層）に新しいフォルダを作成する。
    // Explorer 以外では VS Code 標準の Cmd+Shift+N の挙動を維持する。
    {
        "key": "shift+cmd+n",
        "command": "explorer.newFolder",
        "when": "filesExplorerFocus && !inputFocus"
    },
    // 集中モードに入る
    {
        "key": "cmd+shift+m",
        "command": "runCommands",
        "when": "!isCenteredLayout",
        "args": {
            "commands": [
                "workbench.action.toggleMaximizeEditorGroup",
                "workbench.action.toggleCenteredLayout"
            ]
        }
    },
    // 集中モードから戻る
    {
        "key": "cmd+shift+m",
        "command": "runCommands",
        "when": "isCenteredLayout",
        "args": {
            "commands": [
                "workbench.action.toggleCenteredLayout",
                "workbench.action.toggleMaximizeEditorGroup"
            ]
        }
    },
    // タブグループ内の移動に変更
    {
        "key": "cmd+alt+right",
        "command": "workbench.action.nextEditorInGroup"
    },
    {
        "key": "cmd+alt+left",
        "command": "workbench.action.previousEditorInGroup"
    },
    {
        "key": "cmd+[",
        "command": "workbench.action.navigateBack",
        "when": "canNavigateBack"
    },
    {
        "key": "cmd+]",
        "command": "workbench.action.navigateForward",
        "when": "canNavigateForward"
    },
    {
        "key": "cmd+[",
        "command": "-editor.action.outdentLines"
    },
    {
        "key": "cmd+]",
        "command": "-editor.action.indentLines"
    }
]
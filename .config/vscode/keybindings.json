[
    // ========================================================================
    // 共通：エディタグループ・タブ操作
    // ========================================================================
    // Ctrl+PageUp/Down でタブグループ内を移動する。
    // 内蔵 Markdown Editor と Lazygit for VSCode のターミナルエディタでも有効にする。
    {
        "key": "ctrl+pagedown",
        "command": "workbench.action.nextEditorInGroup",
        "when": "editorTextFocus || markdownEditorFocus || (activeCustomEditorId == 'vscode.markdown.editor' && !inputFocus) || (terminalEditorFocus && lazygitFocus)"
    },
    {
        "key": "ctrl+pageup",
        "command": "workbench.action.previousEditorInGroup",
        "when": "editorTextFocus || markdownEditorFocus || (activeCustomEditorId == 'vscode.markdown.editor' && !inputFocus) || (terminalEditorFocus && lazygitFocus)"
    },
    // macOS 既定の Cmd+Option+←/→ によるタブ移動を解除する。
    // タブ移動は Ctrl+PageUp/Down に統一する。
    {
        "key": "cmd+alt+right",
        "command": "-workbench.action.nextEditor"
    },
    {
        "key": "cmd+alt+left",
        "command": "-workbench.action.previousEditor"
    },
    // エディタを上のグループへ移動する。
    // Ctrl+Cmd+←/→ の上下版として使う想定。
    {
        "key": "ctrl+cmd+up",
        "command": "workbench.action.moveEditorToAboveGroup"
    },
    // エディタを下のグループへ移動する。
    // Open Definition to the Side で横に開いた定義元を下へ送る時に便利。
    {
        "key": "ctrl+cmd+down",
        "command": "workbench.action.moveEditorToBelowGroup"
    },
    // ========================================================================
    // Markdown：表示切り替え
    // ========================================================================
    // Cmd+E で内蔵 Markdown Editor のプレビュー（ロック）と編集可能な表示を切り替える。
    // Markdown Editor を開いた直後も、本文のクリックなしで切り替えられるようにする。
    {
        "key": "cmd+e",
        "command": "markdown.editor.toggleLocked",
        "when": "activeCustomEditorId == 'vscode.markdown.editor' && !inputFocus"
    },
    // ========================================================================
    // テキストエディタ：補完・スクロール
    // ========================================================================
    // インライン補完を表示させる。
    {
        "key": "alt+/",
        "command": "editor.action.triggerSuggest",
        "when": "editorHasCompletionItemProvider && textInputFocus && !editorReadonly && !suggestWidgetVisible"
    },
    {
        "key": "alt+escape",
        "command": "-editor.action.triggerSuggest",
        "when": "editorHasCompletionItemProvider && textInputFocus && !editorReadonly && !suggestWidgetVisible"
    },
    // Option+PageUp/Down は1行スクロール。
    {
        "key": "alt+pageup",
        "command": "scrollLineUp",
        "when": "textInputFocus"
    },
    {
        "key": "alt+pagedown",
        "command": "scrollLineDown",
        "when": "textInputFocus"
    },
    // PageUp/Down は半ページずつスクロールする。
    {
        "key": "pageup",
        "command": "editorScroll",
        "when": "textInputFocus",
        "args": {
            "to": "up",
            "by": "halfPage"
        }
    },
    {
        "key": "pagedown",
        "command": "editorScroll",
        "when": "textInputFocus",
        "args": {
            "to": "down",
            "by": "halfPage"
        }
    },
    // ========================================================================
    // Explorer：ファイル操作・移動
    // ========================================================================
    // 選択中のフォルダ配下（ファイル選択時は同じ階層）に新しいファイルを作成する。
    {
        "key": "cmd+n",
        "command": "explorer.newFile",
        "when": "filesExplorerFocus && !inputFocus"
    },
    // Explorer 内の Cmd+Left で全フォルダを折りたたむ。
    // 修飾キーなしの Left は VS Code 標準の動作のままにする。
    {
        "key": "cmd+left",
        "command": "workbench.files.action.collapseExplorerFolders",
        "when": "filesExplorerFocus && !inputFocus"
    },
    // Explorer の → はフォルダを展開し、ファイルなら開いて編集エリアに戻る。
    // ファイルを開いたときは従来の Cmd+Down と同様にパネルとサイドバーも閉じる。
    {
        "key": "right",
        "command": "list.expand",
        "when": "filesExplorerFocus && explorerResourceIsFolder && !inputFocus"
    },
    {
        "key": "right",
        "command": "runCommands",
        "when": "filesExplorerFocus && !explorerResourceIsFolder && !inputFocus",
        "args": {
            "commands": [
                "list.select",
                "workbench.action.closePanel",
                "workbench.action.closeSidebar",
                "workbench.action.focusActiveEditorGroup"
            ]
        }
    },
    // Explorer の先頭・末尾へ移動する。編集エリアの Cmd+Up/Down は変更しない。
    {
        "key": "cmd+up",
        "command": "list.focusFirst",
        "when": "filesExplorerFocus && !inputFocus"
    },
    {
        "key": "cmd+down",
        "command": "list.focusLast",
        "when": "filesExplorerFocus && !inputFocus"
    },
    // ========================================================================
    // パネル：Problems・Output・Terminal などのタブ切り替え
    // ========================================================================
    // パネルにフォーカスがあるときだけ Ctrl+PageUp/Down で切り替える。
    {
        "key": "ctrl+pagedown",
        "command": "workbench.action.nextPanelView",
        "when": "panelFocus"
    },
    {
        "key": "ctrl+pageup",
        "command": "workbench.action.previousPanelView",
        "when": "panelFocus"
    },
    // ========================================================================
    // ターミナル：コピー
    // ========================================================================
    // テキストが選択されていない場合、直前のコマンドと実行結果をコピーする。
    {
        "key": "cmd+c",
        "command": "workbench.action.terminal.copyLastCommandAndLastCommandOutput",
        "when": "terminalFocus && !terminalTextSelected"
    },
    // ========================================================================
    // タスク：実行
    // ========================================================================
    // tasks.json のデフォルトテストタスク。
    {
        "key": "f13",
        "command": "workbench.action.tasks.test"
    }
]